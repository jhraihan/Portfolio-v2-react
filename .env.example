# Contact form endpoint. Set ONE of these (both are public by design and
# rate-limited by the provider, so they are safe to commit or inline).
# With neither set, the form opens the visitor's mail app with the message
# already written, so it still works.

# Formspree: create a form at https://formspree.io and paste its endpoint.
VITE_CONTACT_ENDPOINT=

# Web3Forms: get an access key at https://web3forms.com (no account needed).
VITE_WEB3FORMS_ACCESS_KEY=

# Optional. The public origin used for canonical and Open Graph URLs and the
# sitemap. On Vercel this is detected automatically from the production
# domain, so leave it empty there unless you want to override it.
VITE_SITE_URL=
